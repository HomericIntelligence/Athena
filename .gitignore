# Ignore distribution output and internal analysis output.
dist/
dist-internal/

# Ignore Python validation caches.
__pycache__/
*.py[cod]
.coverage
.coverage.*
coverage.json
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Ignore Python virtual environments.
.venv/
venv/

# Ignore secrets and credentials as an additional security control.
# These ignore rules are one defense-in-depth layer.
# Secret files must never be committed.
.env
.env.*
*.pem
*.key
secrets/

# Ignore editor and operating-system files.
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# Ignore Athena skill output from local iteration.
skills/_out/
skills/_drafts/

# Ignore local plugin-scanner output. The scanner writes output in this directory.
.scanner-out/
