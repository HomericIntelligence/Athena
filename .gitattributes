# Normalize text files to line feed (LF) endings and prevent mixed line endings.
# The file patterns below select carriage return and line feed (CRLF) endings when required.

# Use line feed (LF) endings for text files by default.
*                 text=auto eol=lf

# Apply the text rule to Python scripts and configuration files.
*.py              text eol=lf
*.pyi             text eol=lf
*.toml            text eol=lf
*.cfg             text eol=lf
*.ini             text eol=lf

# Apply the text rule to YAML, JSON, and Markdown files.
*.yml             text eol=lf
*.yaml            text eol=lf
*.json            text eol=lf
*.md              text eol=lf

# Apply the text rule to shell scripts.
*.sh              text eol=lf

# Use CRLF endings for Windows command and PowerShell scripts.
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# Treat these file formats as binary data.
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.pdf             binary
*.gz              binary
*.zip             binary
*.tar             binary

# Treat these secret and credential file patterns as binary data.
# This rule prevents text normalization and content display in diffs or patches.
# The rule applies only to the patterns below. The .gitignore file excludes other
# secret paths, such as the secrets/ directory.
.env              binary
.env.*            binary
*.pem             binary
*.key             binary
