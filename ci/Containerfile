# This Containerfile builds the athena-ci image for Athena plugin validation.
# Continuous integration (CI) uses this image.
#
# This image contains Python 3.13. This version satisfies requires-python >=3.13,<3.14.
# The image contains uv and the locked development environment.
# The image contains the pre-commit hook environments.
# The image uses the non-root user 'ci' for compatibility with rootless Podman.
#
# The toolchain uses uv as Architecture Decision Record (ADR) 017 specifies.
# This Containerfile follows the pattern in the Scylla ci/Containerfile.
#
# Build the image with one of these commands:
#   podman build -f ci/Containerfile -t athena-ci:local .
#   docker build -f ci/Containerfile -t athena-ci:local .
#
# Run the image with one of these commands:
#   podman run --rm -v .:/workspace:Z athena-ci:local uv run pytest tests
#   podman run --rm -v .:/workspace:Z athena-ci:local uv run pre-commit run --all-files

# ============================================================================
# Stage 0 installs the uv binary from a pinned GitHub release.
# The checksum verifies the release archive.
# Podman, Buildah, and Docker resolve the same release artifact.
# This method does not copy a third-party image between registries.
# The version tags for the ghcr.io astral-sh/uv image do not track uv command-line
# interface versions. For example, version 0.11.21 is not available there.
# Thus, this stage pins the release archive.
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS uv

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://github.com/astral-sh/uv/releases/download/0.12.1/uv-x86_64-unknown-linux-gnu.tar.gz -o /tmp/uv.tar.gz \
    && echo "90b2f223fb69d19db49e117da601f64978593417988530aa733d456141b4bcbb  /tmp/uv.tar.gz" | sha256sum --check \
    && tar xzf /tmp/uv.tar.gz -C /usr/local/bin --strip-components=1 \
    && rm /tmp/uv.tar.gz

# ============================================================================
# Stage 1 installs uv and the locked project environment.
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Build the project virtual environment in a fixed location that the build can copy.
    UV_PROJECT_ENVIRONMENT=/opt/athena-venv \
    # Compile bytecode during installation to make cold starts faster.
    UV_COMPILE_BYTECODE=1 \
    # Copy files from the cache. Do not use hard links.
    # This action makes the virtual environment self-contained for COPY --from=builder.
    UV_LINK_MODE=copy \
    PATH="/opt/athena-venv/bin:$PATH"

# Install the build dependencies and Git. The pre-commit hooks require Git.
# Install security updates that the pinned base image does not contain.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install the pinned uv release.
# When you update uv, update the release URL and SHA-256 checksum together.
# Also update astral-sh/setup-uv in .github/workflows/*.yml to the same version.
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# Layer 1 copies the dependency files. Dependency changes invalidate this cache layer.
WORKDIR /opt/athena-build
COPY uv.lock pyproject.toml .pre-commit-config.yaml README.md ./

# Layer 2 installs the locked development dependencies in the virtual environment.
# The --no-install-project option defers installation of the project.
# The full source tree is not present in this layer.
# Thus, source changes do not invalidate this cache layer.
RUN uv sync --locked --no-install-project

# Layer 3 installs the pre-commit hook environments.
# This installation lets 'pre-commit run --all-files' start immediately.
# The command does not have to download hook repositories or create virtual environments in CI.
# The pre-commit install-hooks command requires a Git repository.
# Thus, initialize a temporary repository.
RUN git init . && \
    uv run pre-commit install-hooks && \
    rm -rf .git

# ============================================================================
# Stage 2 builds the minimal runtime image without build tools.
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

LABEL org.opencontainers.image.title="athena-ci"
LABEL org.opencontainers.image.description="This Athena continuous integration container validates, lints, and builds packages."
LABEL org.opencontainers.image.vendor="Athena"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/Athena"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/athena-venv \
    UV_LINK_MODE=copy \
    PATH="/opt/athena-venv/bin:$PATH"

# Install only the required runtime system packages. Do not install build tools.
# Install security updates that the pinned base image does not contain.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the uv binaries and the installed project virtual environment from the builder.
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
COPY --from=builder /opt/athena-venv /opt/athena-venv

# Copy the installed pre-commit hook environments from the builder cache.
COPY --from=builder /root/.cache/pre-commit /root/.cache/pre-commit

# Create a non-root user for compatibility with rootless Podman.
# User identifier (UID) 1000 identifies the first user on most Linux systems.
# This UID usually matches the developer UID and permits volume access without --userns=keep-id.
RUN groupadd -r ci && useradd -r -g ci -u 1000 -m -s /bin/bash ci

# Copy the pre-commit cache to the home directory of the ci user.
# The pre-commit tool uses $HOME/.cache.
RUN cp -r /root/.cache/pre-commit /home/ci/.cache/ 2>/dev/null || true && \
    chown -R ci:ci /home/ci/.cache

# Use the mounted repository root as the runtime working directory.
WORKDIR /workspace

# Do not set ENTRYPOINT. CI or run_ci_local.sh supplies the command.
# For example, run this command:
#   podman run --rm -v .:/workspace:Z athena-ci:local uv run pytest

USER ci
